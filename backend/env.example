# Server Configuration
PORT=8080

# JWT Configuration
JWT_SECRET=your-secret-key-here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=spectro_lab
DB_SSLMODE=disable

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tunnel.wcrum.dev

# OIDC Configuration
OIDC_INTERNAL_ISSUER=http://dex:5556/dex
OIDC_EXTERNAL_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=spectro-lab-client
OIDC_CLIENT_SECRET=spectro-lab-secret
OIDC_REDIRECT_URL=https://tunnel.wcrum.dev/auth/callback

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://tunnel.wcrum.dev

